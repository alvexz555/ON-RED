
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html, body {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: fixed;
    overscroll-behavior: none;
    touch-action: none;
    background: #151515;
}

body {
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
}

#gameCanvas {
    display: block;
    width: 100vw;
    height: 100dvh;
    touch-action: none;
}
