
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html, body {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: fixed;
    inset: 0;
    overscroll-behavior: none;
    touch-action: none;

    background:
        radial-gradient(
            ellipse at 50% 45%,
            #101d3b 0%,
            #080f20 48%,
            #03060d 100%
        );
}

body {
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
}

#gameCanvas {
    position: fixed;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
}
